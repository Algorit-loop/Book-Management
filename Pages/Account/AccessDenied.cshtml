@page
@model RazorInMemoryDemo.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white text-center">
                    <h2><i class="bi bi-exclamation-triangle-fill me-2"></i>Access Denied</h2>
                </div>
                <div class="card-body text-center">
                    <p class="lead">You do not have permission to access this resource.</p>
                    <a class="btn btn-primary mt-3" asp-page="/Index">Return to Home</a>
                </div>
            </div>
        </div>
    </div>
</div> 